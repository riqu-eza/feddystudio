generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ---------- NEXTAUTH ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ---------- APP MODELS ----------
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  icon        String   @default("📸")
  title       String   @unique
  description String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rate {
  id         String   @id @default(cuid())
  icon       String   @default("📸")
  title      String   @unique
  price      String
  items      Json
  ctaLabel   String   @default("Book Now")
  ctaMessage String
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model PortfolioItem {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  category  String
  imageUrl  String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Booking {
  id              String    @id @default(cuid())
  name            String
  phone           String
  service         String
  date            DateTime
  message         String?
  referral        String?
  depositType     String    @default("fixed")
  depositValue    Float     @default(0)
  depositAmount   Float?
  status          String    @default("pending")
  mpesaReceipt    String?
  mpesaCheckoutId String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([date])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
}
